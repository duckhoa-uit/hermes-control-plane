{
  "name": "control-plan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "bash scripts/dev-setup.sh",
    "dev": "wrangler dev",
    "deploy": "flue build --target cloudflare && wrangler deploy",
    "test:worker": "flue build --target cloudflare && RUN_WORKER_HARNESS=1 vitest run tests/worker-harness.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "CI=1 vitest run --coverage",
    "deadcode": "knip",
    "prepare": "husky",
    "bundle:size": "bun run scripts/bundle-size.ts",
    "flags:check": "bun run scripts/detect-dead-flags.ts",
    "dupes": "jscpd"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.4",
    "@flue/github": "1.0.0-beta.1",
    "@flue/runtime": "1.0.0-beta.9",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@octokit/rest": "^22.0.0",
    "agents": "^0.14.0",
    "hono": "^4.7.0",
    "jose": "^6.2.3",
    "valibot": "^1.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@flue/cli": "1.0.0-beta.9",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "husky": "^9.1.7",
    "jscpd": "^5.2.1",
    "knip": "^6.36.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.83.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "4.114.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,jsonc,md}": [
      "biome format --write --no-errors-on-unmatched"
    ],
    "*.{ts,tsx,js,mjs}": [
      "oxlint --fix"
    ]
  }
}
